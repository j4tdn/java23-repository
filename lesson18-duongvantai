
CREATE DATABASE ktra;
CREATE TABLE CLASS(
	class_id INT AUTO_INCREMENT,
    class_name VARCHAR(255) NOT NULL,
    teacher VARCHAR(255) NOT NULL,
    PRIMARY KEY(class_id)
    );
CREATE TABLE STUDENT(
	student_id INT AUTO_INCREMENT,
    student_name VARCHAR(225) NOT NULL,
    gender VARCHAR(255) NOT NULL,
    class_id INT NOT NULL,
    PRIMARY KEY(student_id),
    CONSTRAINT FOREIGN KEY(class_id) REFERENCES CLASS(class_id)		
);
CREATE TABLE RESULT(
	student_id INT NOT NULL,
    result_subject VARCHAR(255) NOT NULL,
    score NUMERIC(2,1) NOT NULL,
  CONSTRAINT FOREIGN KEY(student_id) REFERENCES STUDENT(student_id)		
    );
    
SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE Result;
SET FOREIGN_KEY_CHECKS = 1;

TRUNCATE TABLE STUDENT;
TRUNCATE TABLE CLASS;
TRUNCATE TABLE RESULT;

